{
  "name": "talent-pilot-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TalentPilot backend: AI recruiting co-worker API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
