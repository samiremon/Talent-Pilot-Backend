# ---------- App (used by `npm run dev`) ----------
# Port the API listens on
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Log detail: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# MongoDB for `npm run dev` (Docker Compose sets its own). Use the same user/password as below.
MONGODB_URI=mongodb://talentpilot:change-me-mongo@localhost:27017/talentpilot?authSource=admin
# Redis for the background-job queue, for `npm run dev` + `npm run worker` (Docker sets its own).
# Use the same password as REDIS_PASSWORD below. Leave empty to run tasks inside the API instead.
REDIS_URL=redis://:change-me-redis@localhost:6379

# ---------- Login ----------
# The recruiter account. It's created automatically the first time the server starts.
# To change the password later: edit it here, then run `npm run seed`
# (in Docker: `docker compose exec api node dist/scripts/seed.js`).
SEED_RECRUITER_EMAIL=recruiter@example.com
SEED_RECRUITER_PASSWORD=change-me-recruiter
SEED_RECRUITER_NAME=Recruiter
# DEMO ONLY: show a "Use demo account" button on the login page that fills in the
# account above. Anyone who opens the site can then log in, so set false for real use.
DEMO_LOGIN_ENABLED=true
# How many hours a login lasts
SESSION_TTL_HOURS=12

# ---------- Accounts ----------
# Where people open the app (links in emails + Google redirect). npm run dev = 5173.
APP_URL=http://localhost:5173
# Same, for Docker (the website is on port 8080 there).
DOCKER_APP_URL=http://localhost:8080
ALLOW_SIGNUP=true
# "Continue with Google" (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application) and add BOTH
# redirect URIs: http://localhost:5173/api/auth/google/callback and
# http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email ----------
# Leave SMTP_HOST/SMTP_PORT empty to use Mailpit, the fake inbox (read mail at
# http://localhost:8025). For real email, fill in your provider's SMTP details,
# e.g. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TalentPilot <no-reply@talentpilot.local>

# ---------- Docker Compose ----------
# Path to the frontend repo (cloned next to this one by default)
FRONTEND_DIR=../Talent-Pilot-Frontend

# Published ports on your machine
WEB_PORT=8080
API_PORT=4000
MAILPIT_UI_PORT=8025
# MongoDB, published on 127.0.0.1 only (for `npm run dev`)
MONGO_PORT=27017
REDIS_PORT=6379

# Database & cache credentials. CHANGE THESE before running.
MONGO_USER=talentpilot
MONGO_PASSWORD=change-me-mongo
REDIS_PASSWORD=change-me-redis

# ---------- AI (Groq) ----------
# Free key from https://console.groq.com/keys. Leave empty to run in mock mode
# (everything still works, with built-in sample AI answers).
GROQ_API_KEY=
# Which Groq model does which job (defaults shown).
AI_MODEL_AGENT=openai/gpt-oss-120b
AI_MODEL_BULK=openai/gpt-oss-20b
AI_MODEL_SAFETY=openai/gpt-oss-safeguard-20b
# Token dashboard (optional). Groq doesn't send its daily TOKEN limit, so copy "TPD" for
# your model from https://console.groq.com/settings/limits to see "tokens left today".
AI_DAILY_TOKEN_LIMIT=
# Groq's free tier has no weekly/monthly limit. Set your own budgets to see "% left".
AI_TOKEN_BUDGET_WEEK=
AI_TOKEN_BUDGET_MONTH=
